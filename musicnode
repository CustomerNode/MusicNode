def fmt_time(ns: int) -> str:
    if ns is None or ns < 0:
        return "0:00"
    s = ns // Gst.SECOND
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def make_video_sink():
    """Return (sink_element_for_playbin, gtk_widget_to_embed).

    Prefer gtkglsink (GL accelerated) wrapped in glsinkbin; fall back to gtksink.
    Returns (None, None) if neither is usable, in which case we leave playbin
    to use its default (which may pop a separate window for video files).
    """
    gl = Gst.ElementFactory.make("gtkglsink", "glsink")
    if gl is not None:
        glbin = Gst.ElementFactory.make("glsinkbin", "glsinkbin")
        if glbin is not None:
            glbin.set_property("sink", gl)
            return glbin, gl.props.widget
    plain = Gst.ElementFactory.make("gtksink", "gtksink")
    if plain is not None:
        return plain, plain.props.widget
    return None, None


