    # --- helpers ----------------------------------------------------------
    def _scroll(self, child):
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        sw.add(child)
        return sw

    _LAYOUT_LABELS = {
        "split":    "↕ Split view",
        "controls": "📋 All controls",
        "video":    "🎬 Video only",
    }
    _LAYOUT_CYCLE = {"split": "controls", "controls": "video", "video": "split"}

    def on_cycle_layout(self, _btn):
        self._view_layout = self._LAYOUT_CYCLE[self._view_layout]
        self._apply_layout()

    def _apply_layout(self):
        """Apply the current in-window layout (called when the user cycles,
        and also when we exit fullscreen so the prior layout is restored)."""
        mode = self._view_layout
        if mode == "split":
            self.video_box.show()
            self.hpaned.show()
            self.transport.show()
            self.transport_sep.show()
            # Restore a sensible split
            h = self.get_allocated_height()
            self.vpaned.set_position(max(h // 2 if h > 0 else 360, 360))
        elif mode == "controls":
            # Hide the video, let the controls take the whole window
            self.video_box.hide()
            self.hpaned.show()
            self.transport.show()
            self.transport_sep.show()
            # Push the split to 0 so the bottom pane gets all available space
            self.vpaned.set_position(0)
        else:  # "video"
            self.video_box.show()
            self.hpaned.hide()
            self.transport.hide()
            self.transport_sep.hide()
            self.vpaned.set_position(-1)
        self.controls_toggle_btn.set_label(self._LAYOUT_LABELS[mode])

    def toggle_fullscreen(self):
        if self.is_fullscreen:
            self.unfullscreen()
        else:
            self.fullscreen()
        # actual show/hide is driven by on_window_state below

    def _apply_fullscreen_layout(self, fs: bool):
        """While fullscreen we always show only the video, ignoring the
        in-window layout. When fullscreen exits we re-apply whichever
        in-window layout the user had chosen."""
        if fs:
            self.header.hide()
            self.video_box.show()
            self.hpaned.hide()
            self.transport.hide()
            self.transport_sep.hide()
            self.vpaned.set_position(-1)
        else:
            self.header.show()
            self._apply_layout()

    def on_window_state(self, _w, event):
        fs = bool(event.new_window_state & Gdk.WindowState.FULLSCREEN)
        if fs != self.is_fullscreen:
            self.is_fullscreen = fs
            self._apply_fullscreen_layout(fs)
        return False

    # --- AirPlay / cast --------------------------------------------------
    def _ensure_raop_module(self):
        """Make PipeWire discover legacy AirPlay (RAOP) receivers on the
        network. Idempotent — pactl will refuse a second load and we ignore
        the error."""
        if self._raop_loaded:
            return
        self._raop_loaded = True
        try:
            subprocess.run(
                ["pactl", "load-module", "module-raop-discover"],
                capture_output=True, text=True, timeout=3,
            )
        except Exception as e:
            sys.stderr.write(f"[musicnode] couldn't load raop module: {e}\n")

    def _list_sinks(self) -> list[dict]:
        try:
            r = subprocess.run(["pactl", "list", "sinks"],
                               capture_output=True, text=True, timeout=3)
            if r.returncode != 0:
                return []
            text = r.stdout
        except Exception:
            return []
        sinks: list[dict] = []
        current: dict = {}
        for line in text.split("\n"):
            stripped = line.strip()
            if line.startswith("Sink #"):
                if current.get("name"):
                    sinks.append(current)
                current = {}
            elif stripped.startswith("Name: "):
                current["name"] = stripped[6:]
            elif stripped.startswith("Description: "):
                current["description"] = stripped[13:]
        if current.get("name"):
            sinks.append(current)
        for s in sinks:
            s["is_airplay"] = s["name"].startswith("raop_sink.")
            s.setdefault("description", s["name"])
        return sinks

    def _friendly_sink_label(self, sink: dict) -> str:
        if not sink["is_airplay"]:
            return sink["description"]
        # raop_sink names look like:  raop_sink.Onkyo-TX-RZ50-63EE22.local.192.168.4.219.7000
        rest = sink["name"][len("raop_sink."):]
        first = rest.split(".", 1)[0]
        return first.replace("-", " ")

    def on_cast_clicked(self, btn):
        self._ensure_raop_module()
        # Module discovery is asynchronous — first click may show 0 AirPlay
        # devices. The Rescan menu item gives a way to re-poll without
        # closing/reopening the menu.
        menu = Gtk.Menu()

        sinks = self._list_sinks()
        local_sinks = [s for s in sinks if not s["is_airplay"]]
        airplay_sinks = [s for s in sinks if s["is_airplay"]]

        def add_sink_item(label: str, sink_name):
            item = Gtk.CheckMenuItem(label=label)
            item.set_draw_as_radio(True)
            item.set_active(self.current_audio_sink == sink_name)
            item.connect("activate", self.on_cast_select, sink_name)
            menu.append(item)

        add_sink_item("🔊 System default (this computer)", None)

        if local_sinks:
            menu.append(Gtk.SeparatorMenuItem())
            for s in local_sinks:
                add_sink_item(f"🔈 {s['description']}", s["name"])

        if airplay_sinks:
            menu.append(Gtk.SeparatorMenuItem())
            header_item = Gtk.MenuItem(label="AirPlay devices")
            header_item.set_sensitive(False)
            menu.append(header_item)
            for s in airplay_sinks:
                add_sink_item(f"📡 {self._friendly_sink_label(s)}", s["name"])
        else:
            menu.append(Gtk.SeparatorMenuItem())
            empty = Gtk.MenuItem(
                label="No AirPlay devices found yet — try Rescan in a sec")
            empty.set_sensitive(False)
            menu.append(empty)

        menu.append(Gtk.SeparatorMenuItem())
        rescan = Gtk.MenuItem(label="🔄 Rescan")
        rescan.connect("activate", lambda *_: self.on_cast_clicked(btn))
        menu.append(rescan)

        menu.show_all()
        menu.popup_at_widget(btn, Gdk.Gravity.SOUTH, Gdk.Gravity.NORTH, None)

    def on_cast_select(self, item, sink_name):
        # CheckMenuItem fires on both toggle on and off; only act on the
        # newly-active one, and only if it's a change.
        if not item.get_active():
            return
        if self.current_audio_sink == sink_name:
            return
        self.current_audio_sink = sink_name
        self._switch_audio_sink(sink_name)

    def _apply_audio_sink(self, sink_name):
        """Build and assign an audio sink element to playbin without
        restarting playback. Use _switch_audio_sink if you need playback
        to follow."""
        if sink_name is None:
            new_sink = Gst.ElementFactory.make("autoaudiosink", "audiosink")
        else:
            new_sink = Gst.ElementFactory.make("pulsesink", "audiosink")
            if new_sink is not None:
                new_sink.set_property("device", sink_name)
        if new_sink is not None:
            self.player.set_property("audio-sink", new_sink)

    def _switch_audio_sink(self, sink_name):
        """Switch the audio sink on a running player. Saves the position,
        rebuilds the pipeline with the new sink, and resumes."""
        was_playing = False
        pos = 0
        if self.current_index >= 0:
            try:
                _, state, _ = self.player.get_state(0)
                was_playing = state in (Gst.State.PLAYING, Gst.State.PAUSED)
                ok, p = self.player.query_position(Gst.Format.TIME)
                if ok and p > 0:
                    pos = p
            except Exception:
                pass

        self.player.set_state(Gst.State.NULL)
        self._apply_audio_sink(sink_name)

        if sink_name:
            label = sink_name
            if sink_name.startswith("raop_sink."):
                label = sink_name[len("raop_sink."):].split(".", 1)[0].replace("-", " ")
            self._toast(f"Casting to {label}")
        else:
            self._toast("Audio: this computer")

        if was_playing and 0 <= self.current_index < len(self.queue_paths):
            path = self.queue_paths[self.current_index]
            self.player.set_property(
                "uri", Gio.File.new_for_path(str(path)).get_uri())
            self.player.set_state(Gst.State.PLAYING)
            if pos > 0:
                def do_seek():
                    self.player.seek_simple(
                        Gst.Format.TIME,
                        Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                        pos)
                    return False
                GLib.timeout_add(700, do_seek)

    def on_key(self, _w, ev):
        kv = ev.keyval
        # Ctrl+F: focus the library search box
        if kv == Gdk.KEY_f and ev.state & Gdk.ModifierType.CONTROL_MASK:
            self.search_entry.grab_focus()
            return True
        # Esc: clear search if focused, else fall through to fullscreen exit
        if kv == Gdk.KEY_Escape and self._search_mode:
            self.search_entry.set_text("")
            self.search_entry.grab_focus()
            return True
        # Don't eat keys while the user is typing in the search box —
        # space etc. need to reach the entry.
        focus = self.get_focus()
        if isinstance(focus, Gtk.Entry):
            return False
        if kv == Gdk.KEY_space:
            self.on_play_pause(None)
            return True
        if kv == Gdk.KEY_F11:
            self.toggle_fullscreen()
            return True
        if kv == Gdk.KEY_Escape and self.is_fullscreen:
            self.toggle_fullscreen()
            return True
        if kv == Gdk.KEY_Right and ev.state & Gdk.ModifierType.CONTROL_MASK:
            self.on_next(None); return True
        if kv == Gdk.KEY_Left and ev.state & Gdk.ModifierType.CONTROL_MASK:
            self.on_prev(None); return True
        if kv == Gdk.KEY_q and ev.state & Gdk.ModifierType.CONTROL_MASK:
            self.on_cycle_layout(None)
            return True
        return False

    # --- file list --------------------------------------------------------
    # --- playlist storage ------------------------------------------------
    def _safe_pl_name(self, name: str) -> str:
        bad = '/\\:*?"<>|'
        cleaned = "".join(c for c in name if c not in bad).strip()
        return cleaned[:100] or "untitled"

    def _all_playlists(self) -> list[str]:
        if not PLAYLISTS_DIR.exists():
            return []
        return sorted(p.stem for p in PLAYLISTS_DIR.glob("*.m3u"))

    def _playlist_tracks(self, name: str) -> list[Path]:
        f = PLAYLISTS_DIR / f"{name}.m3u"
        if not f.exists():
            return []
        out: list[Path] = []
        for line in f.read_text(errors="replace").splitlines():
            s = line.strip()
            if s and not s.startswith("#"):
                p = Path(s)
                if p.exists():
                    out.append(p)
        return out

    def _write_playlist(self, name: str, paths: list[Path]):
        PLAYLISTS_DIR.mkdir(parents=True, exist_ok=True)
        f = PLAYLISTS_DIR / f"{self._safe_pl_name(name)}.m3u"
        lines = ["#EXTM3U"]
        lines.extend(str(p) for p in paths)
        f.write_text("\n".join(lines) + "\n")

    def _delete_playlist(self, name: str) -> bool:
        f = PLAYLISTS_DIR / f"{name}.m3u"
        if not f.exists():
            return False
        f.unlink()
        return True

    # --- view dispatcher --------------------------------------------------
    def reload_files(self):
        if self._view_mode == "playlist-list":
            self._reload_playlist_list()
        elif self._view_mode == "playlist":
            self._reload_playlist_tracks()
        else:
            self._reload_file_view()

    def _reload_file_view(self):
        if not self.folder.exists():
            self.files_store.clear()
            self.folder_label.set_text(f"{self.folder} (missing)")
            self.path_label.set_text("(folder missing)")
            return
        # Keep current_dir within the music root
        try:
            self.current_dir.resolve().relative_to(self.folder.resolve())
        except (ValueError, FileNotFoundError):
            self.current_dir = self.folder

        folders: list[tuple[str, Path]] = []
        files: list[tuple[str, Path]] = []
        try:
            for p in self.current_dir.iterdir():
                if p.is_dir():
                    folders.append((f"📁  {p.name}", p))
                elif p.is_file() and p.suffix.lower() in MEDIA_EXTS:
                    files.append((p.stem, p))
        except PermissionError:
            pass
        folders.sort(key=lambda x: x[0].lower())
        files.sort(key=lambda x: x[0].lower())

        # Detach the model from the view while we rebuild — avoids per-row
        # redraws and dramatically reduces flicker for big folders.
        self.files_view.freeze_child_notify()
        self.files_view.set_model(None)
        try:
            self.files_store.clear()
            at_root = self.current_dir.resolve() == self.folder.resolve()
            if not at_root:
                self.files_store.append(["⬆  ..", str(self.current_dir.parent), True, True])
            # Pin "📋 Playlists" at the top when sitting at music root
            if at_root:
                n_pl = len(self._all_playlists())
                self.files_store.append(
                    [f"📋  Playlists  ({n_pl})", "_playlists", True, False])
            for display, p in folders:
                self.files_store.append([display, str(p), True, False])
            for display, p in files:
                self.files_store.append([display, str(p), False, False])
        finally:
            self.files_view.set_model(self.files_store)
            self.files_view.thaw_child_notify()

        # Breadcrumb-ish path label
        try:
            rel = self.current_dir.resolve().relative_to(self.folder.resolve())
            crumb = "/" if str(rel) == "." else f"/{rel}"
        except ValueError:
            crumb = str(self.current_dir)
        self.path_label.set_text(crumb)
        self.folder_label.set_text(
            f"{self.folder}   ({len(files)} files, {len(folders)} folders here)")

    def _reload_playlist_list(self):
        names = self._all_playlists()
        self.files_view.freeze_child_notify()
        self.files_view.set_model(None)
        try:
            self.files_store.clear()
            self.files_store.append(["⬆  back to files", "_back-to-files", True, True])
            for n in names:
                count = len(self._playlist_tracks(n))
                self.files_store.append(
                    [f"📋  {n}   ({count} tracks)", f"_playlist:{n}", True, False])
            if not names:
                self.files_store.append(
                    ["(no playlists yet — use 💾 Save queue → playlist)",
                     "_noop", False, False])
        finally:
            self.files_view.set_model(self.files_store)
            self.files_view.thaw_child_notify()
        self.path_label.set_text("📋 Playlists")
        self.folder_label.set_text(f"saved playlists: {len(names)}")
        self.add_folder_btn.set_sensitive(False)
        self.shuffle_folder_btn.set_sensitive(False)

    def _reload_playlist_tracks(self):
        name = self._playlist_view or ""
        tracks = self._playlist_tracks(name)
        self.files_view.freeze_child_notify()
        self.files_view.set_model(None)
        try:
            self.files_store.clear()
            self.files_store.append(["⬆  back to playlists", "_back-to-playlists", True, True])
            for p in tracks:
                self.files_store.append([f"🎵  {p.stem}", str(p), False, False])
        finally:
            self.files_view.set_model(self.files_store)
            self.files_view.thaw_child_notify()
        self.path_label.set_text(f"📋 / {name}")
        self.folder_label.set_text(f"playlist: {name} ({len(tracks)} tracks)")
        # In playlist mode, folder buttons turn into "queue the playlist"
        self.add_folder_btn.set_sensitive(True)
        self.shuffle_folder_btn.set_sensitive(True)

    # --- drag and drop ----------------------------------------------------
    def _unique_dest(self, dest: Path) -> Path:
        """If dest exists, return dest with ' (1)', ' (2)', ... suffix."""
        if not dest.exists():
            return dest
        stem, suffix = dest.stem, dest.suffix
        n = 1
        while True:
            candidate = dest.with_name(f"{stem} ({n}){suffix}")
            if not candidate.exists():
                return candidate
            n += 1

    def on_drag_data_received(self, _w, ctx, _x, _y, data, _info, _time):
        # Ignore drags that started inside our own app — those are
        # files-to-queue moves, handled by queue_view directly.
        # (In GTK 3, get-source-widget is a free function, not a context method.)
        if Gtk.drag_get_source_widget(ctx) is not None:
            return
        # Drops land in the folder you're currently browsing
        target_dir = self.current_dir if self.current_dir.exists() else self.folder
        if not target_dir.exists():
            try:
                target_dir.mkdir(parents=True, exist_ok=True)
            except Exception as e:
                self._toast(f"Can't create folder: {e}")
                return

        uris = [u for u in data.get_uris() if u]
        copied, skipped, errors = [], [], []
        for uri in uris:
            parsed = urlparse(uri)
            if parsed.scheme != "file":
                skipped.append(uri)
                continue
            src = Path(unquote(parsed.path))
            if not src.exists() or not src.is_file():
                skipped.append(str(src))
                continue
            if src.suffix.lower() not in MEDIA_EXTS:
                skipped.append(src.name)
                continue
            dest = self._unique_dest(target_dir / src.name)
            try:
                if src.resolve() == dest.resolve():
                    continue  # already in target folder
                shutil.copy2(src, dest)
                copied.append(dest)
            except Exception as e:
                errors.append(f"{src.name}: {e}")

        if copied or errors or skipped:
            self.reload_files()
            parts = []
            if copied:
                parts.append(f"copied {len(copied)} file{'s' if len(copied) != 1 else ''}")
            if skipped:
                parts.append(f"skipped {len(skipped)}")
            if errors:
                parts.append(f"errors: {len(errors)}")
                for e in errors:
                    sys.stderr.write(f"[musicnode] drop error: {e}\n")
            self._toast(" · ".join(parts))

    def _toast(self, text: str):
        """Briefly show a status message in the now-playing label area."""
        prev = self.now_label.get_text()
        self.now_label.set_text(text)
        # restore after a few seconds, but don't clobber a track that started since
        def restore():
            if self.now_label.get_text() == text:
                self.now_label.set_text(prev)
            return False
        GLib.timeout_add(2500, restore)

    def on_choose_folder(self, _btn):
        dlg = Gtk.FileChooserDialog(
            title="Choose folder", parent=self,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
        )
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "Select", Gtk.ResponseType.OK)
        dlg.set_current_folder(str(self.folder if self.folder.exists() else Path.home()))
        if dlg.run() == Gtk.ResponseType.OK:
            self.folder = Path(dlg.get_filename())
            self.current_dir = self.folder
            self.reload_files()
        dlg.destroy()

    # --- queue ops --------------------------------------------------------
    def selected_file_paths(self) -> list[Path]:
        """All selected media files (folders + '..' excluded)."""
        sel = self.files_view.get_selection()
        model, paths = sel.get_selected_rows()
        return [Path(model[p][1]) for p in paths if not model[p][2]]

    def on_file_activated(self, _view, path, _col):
        row = self.files_store[path]
        target_path, is_folder, _is_up = row[1], row[2], row[3]

        # Playlist-mode sentinels
        if target_path == "_noop":
            return
        if target_path == "_playlists":
            self._view_mode = "playlist-list"
            self.reload_files()
            return
        if target_path == "_back-to-files":
            self._view_mode = "files"
            self._playlist_view = None
            self.current_dir = self.folder
            self.add_folder_btn.set_sensitive(True)
            self.shuffle_folder_btn.set_sensitive(True)
            self.reload_files()
            return
        if target_path == "_back-to-playlists":
            self._view_mode = "playlist-list"
            self._playlist_view = None
            self.reload_files()
            return
        if target_path.startswith("_playlist:"):
            self._view_mode = "playlist"
            self._playlist_view = target_path[len("_playlist:"):]
            self.reload_files()
            return

        if is_folder:
            self.current_dir = Path(target_path)
            self.reload_files()
            return
        # Media file: add to queue, autoplay if nothing is playing
        self.queue_paths.append(Path(target_path))
        self.refresh_queue_view()
        if self.current_index == -1:
            self.play_index(len(self.queue_paths) - 1)

    def _schedule_add_label_update(self):
        if self._add_label_pending:
            return
        self._add_label_pending = True
        GLib.idle_add(self._do_update_add_label)

    def _do_update_add_label(self):
        self._add_label_pending = False
        n = len(self.selected_file_paths())
        if n == 0:
            new = "Add to queue ▶"
        elif n == 1:
            new = "Add 1 to queue ▶"
        else:
            new = f"Add {n} to queue ▶"
        if self.add_btn.get_label() != new:
            self.add_btn.set_label(new)
        return False  # don't repeat

    # Compatibility wrapper kept in case other code referenced this
    def _update_add_button_label(self):
        self._schedule_add_label_update()

    def on_files_key(self, view, event):
        if event.keyval == Gdk.KEY_a and event.state & Gdk.ModifierType.CONTROL_MASK:
            view.get_selection().select_all()
            return True
        if event.keyval == Gdk.KEY_Return:
            # Enter on multi-selection adds all and starts playing first
            self.on_add_clicked(None)
            return True
        return False

    def on_nav_home(self, _btn):
        self._view_mode = "files"
        self._playlist_view = None
        self.current_dir = self.folder
        self.add_folder_btn.set_sensitive(True)
        self.shuffle_folder_btn.set_sensitive(True)
        self.reload_files()

    def on_nav_up(self, _btn):
        if self._view_mode == "playlist":
            self._view_mode = "playlist-list"
            self._playlist_view = None
            self.reload_files()
            return
        if self._view_mode == "playlist-list":
            self._view_mode = "files"
            self.current_dir = self.folder
            self.add_folder_btn.set_sensitive(True)
            self.shuffle_folder_btn.set_sensitive(True)
            self.reload_files()
            return
        if self.current_dir.resolve() != self.folder.resolve():
            self.current_dir = self.current_dir.parent
            self.reload_files()

    def _ask_text(self, title: str, prompt: str, default: str = "") -> str | None:
        """Modal one-line text prompt. Returns the entered text or None."""
        dlg = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL,
                        "OK", Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_margin_top(10); box.set_margin_bottom(10)
        box.set_margin_start(12); box.set_margin_end(12)
        box.set_spacing(6)
        lbl = Gtk.Label(label=prompt, xalign=0)
        box.pack_start(lbl, False, False, 0)
        entry = Gtk.Entry()
        entry.set_text(default)
        entry.set_activates_default(True)
        box.pack_start(entry, False, False, 0)
        dlg.show_all()
        result = entry.get_text().strip() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        return result or None

    def _ask_confirm(self, title: str, message: str) -> bool:
        dlg = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text=title, secondary_text=message,
        )
        ok = dlg.run() == Gtk.ResponseType.OK
        dlg.destroy()
        return ok

    def on_save_queue_as_playlist(self, _btn):
        if not self.queue_paths:
            self._toast("Queue is empty — nothing to save")
            return
        name = self._ask_text(
            "Save playlist",
            f"Name for this playlist of {len(self.queue_paths)} tracks:",
            "My Playlist")
        if not name:
            return
        self._write_playlist(name, self.queue_paths)
        self._toast(f"saved playlist '{name}' ({len(self.queue_paths)} tracks)")
        # If user is viewing the playlist list, refresh so they see it
        if self._view_mode == "playlist-list":
            self.reload_files()

    def on_delete_current_playlist(self, _btn):
        name = self._playlist_view
        if not name:
            return
        if not self._ask_confirm(
                f"Delete playlist '{name}'?",
                "The audio files are untouched; only the playlist itself is removed."):
            return
        if self._delete_playlist(name):
            self._toast(f"deleted playlist '{name}'")
        # back to playlist list
        self._view_mode = "playlist-list"
        self._playlist_view = None
        self.reload_files()

    def on_rename_current_playlist(self, _btn):
        old = self._playlist_view
        if not old:
            return
        new = self._ask_text("Rename playlist", f"New name for '{old}':", old)
        if not new or new == old:
            return
        tracks = self._playlist_tracks(old)
        self._write_playlist(new, tracks)
        self._delete_playlist(old)
        self._playlist_view = self._safe_pl_name(new)
        self.reload_files()
        self._toast(f"renamed to '{new}'")

    def on_open_in_file_manager(self, _btn):
        target = self.current_dir if self.current_dir.exists() else self.folder
        try:
            Gio.AppInfo.launch_default_for_uri(
                Gio.File.new_for_path(str(target)).get_uri(), None)
        except Exception as e:
            self._toast(f"Couldn't open: {e}")

    def on_add_clicked(self, _btn):
        chosen = self.selected_file_paths()
        if not chosen:
            return
        was_empty = self.current_index == -1
        start_at = len(self.queue_paths)
        self.queue_paths.extend(chosen)
        self.refresh_queue_view()
        if was_empty:
            self.play_index(start_at)

    def on_add_top_clicked(self, _btn):
        """Insert selected files at the START of the queue.
        If something is playing, the new items go right BEFORE it so
        they play next, and current_index shifts to track the playing
        song."""
        chosen = self.selected_file_paths()
        if not chosen:
            return
        if self.current_index == -1:
            # Nothing playing — insert at index 0 and start
            self.queue_paths[0:0] = chosen
            self.refresh_queue_view()
            self.play_index(0)
            return
        # Insert right after the currently-playing track so the next thing
        # we play is the first new item
        insert_at = self.current_index + 1
        self.queue_paths[insert_at:insert_at] = chosen
        self.refresh_queue_view()
        self._toast(f"queued next: {len(chosen)} track{'s' if len(chosen) != 1 else ''}")

    # --- library search ---------------------------------------------------
    def _on_search_changed(self, entry):
        # Debounce: delay actual search by 250ms so we don't re-filter on
        # every keystroke for a 96k-file library.
        if self._search_timer is not None:
            GLib.source_remove(self._search_timer)
        text = entry.get_text().strip()
        if not text:
            self._search_timer = None
            self._exit_search()
            return
        self._search_timer = GLib.timeout_add(
            250, lambda: (self._run_search(text), False)[1])

    def _build_search_index(self):
        """Walk the CURRENT subtree (current_dir) and cache every media
        file path. Rebuilt when the user navigates into a different
        folder or hits Refresh."""
        idx: list[Path] = []
        root = self.current_dir
        try:
            for p in root.rglob("*"):
                if p.is_file() and p.suffix.lower() in MEDIA_EXTS:
                    idx.append(p)
        except (OSError, PermissionError):
            pass
        self._search_index = idx
        self._search_index_root = root

    def _run_search(self, query: str):
        # Rebuild the index if it's stale (different folder, or never built)
        if (self._search_index is None
                or self._search_index_root != self.current_dir):
            self._build_search_index()
        q = query.lower()
        results: list[Path] = []
        for p in self._search_index:
            if q in str(p).lower():
                results.append(p)
                if len(results) >= 1000:  # cap for UI sanity
                    break
        self._show_search_results(results, query)

    def _show_search_results(self, results: list[Path], query: str):
        self._search_mode = True
        self.add_folder_btn.set_sensitive(False)
        self.shuffle_folder_btn.set_sensitive(False)
        try:
            scope = "/" + str(self.current_dir.relative_to(self.folder))
            if scope == "/.":
                scope = "/"
        except ValueError:
            scope = str(self.current_dir)
        self.path_label.set_text(
            f"🔎 {len(results)} hit(s) for '{query}' under {scope}")
        self.files_view.freeze_child_notify()
        self.files_view.set_model(None)
        try:
            self.files_store.clear()
            base = self.current_dir
            for p in results:
                try:
                    display = f"🎵 {p.relative_to(base)}"
                except ValueError:
                    display = f"🎵 {p}"
                self.files_store.append([display, str(p), False, False])
        finally:
            self.files_view.set_model(self.files_store)
            self.files_view.thaw_child_notify()

    def _exit_search(self):
        if not self._search_mode and self._search_timer is None:
            return
        self._search_mode = False
        self.add_folder_btn.set_sensitive(True)
        self.shuffle_folder_btn.set_sensitive(True)
        self.reload_files()

    def _collect_media(self, root: Path) -> list[Path]:
        """Recursively collect media files under `root`, sorted alphabetically."""
        out: list[Path] = []
        try:
            for p in root.rglob("*"):
                if p.is_file() and p.suffix.lower() in MEDIA_EXTS:
                    out.append(p)
        except (OSError, PermissionError):
            pass
        out.sort(key=lambda p: str(p).lower())
        return out

    def _add_folder_to_queue(self, shuffle: bool):
        # Determine which folders to add. If folder rows are selected in the
        # file list, use those. Otherwise add whatever's in the current_dir.
        sel = self.files_view.get_selection()
        model, paths = sel.get_selected_rows()
        chosen_folders = [Path(model[p][1]) for p in paths
                          if model[p][2] and not model[p][3]]  # is_folder, not ".."

        if not chosen_folders:
            chosen_folders = [self.current_dir]

        all_media: list[Path] = []
        for folder in chosen_folders:
            all_media.extend(self._collect_media(folder))

        if not all_media:
            self._toast("No media files found in that folder")
            return

        if shuffle:
            random.shuffle(all_media)

        was_empty = self.current_index == -1
        start_at = len(self.queue_paths)
        self.queue_paths.extend(all_media)
        self.refresh_queue_view()
        if was_empty:
            self.play_index(start_at)
        verb = "shuffled" if shuffle else "added"
        n = len(all_media)
        self._toast(f"{verb} {n} file{'s' if n != 1 else ''} to queue")

    def on_add_folder_clicked(self, _btn):
        self._add_folder_to_queue(shuffle=False)

    def on_shuffle_folder_clicked(self, _btn):
        self._add_folder_to_queue(shuffle=True)

    def on_shuffle_queue(self, _btn):
        if not self.queue_paths:
            return
        playing = (self.queue_paths[self.current_index]
                   if 0 <= self.current_index < len(self.queue_paths) else None)
        random.shuffle(self.queue_paths)
        if playing is not None:
            try:
                self.current_index = self.queue_paths.index(playing)
            except ValueError:
                pass
        self.refresh_queue_view()
        self._toast(f"shuffled {len(self.queue_paths)} tracks")

    def on_queue_activated(self, _view, path, _col):
        self.play_index(path.get_indices()[0])

    # --- file-list click+drag selection ----------------------------------
    DRAG_THRESHOLD = 4  # pixels of motion before we commit to drag/marquee

    def _on_files_press(self, view, event):
        if event.button != 1:
            self._marquee = None
            return False
        # Double-click: route straight to the activation handler ourselves,
        # since we eat single-click presses below (which would otherwise
        # block GTK's built-in double-click detection).
        if event.type == Gdk.EventType._2BUTTON_PRESS:
            self._marquee = None
            path_info = view.get_path_at_pos(int(event.x), int(event.y))
            if path_info is not None:
                tree_path, _col, _, _ = path_info
                self.on_file_activated(view, tree_path, None)
            return True
        # If Ctrl/Shift held, let GTK handle the toggle/range click directly.
        if event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK):
            self._marquee = None
            return False

        sel = view.get_selection()
        path_info = view.get_path_at_pos(int(event.x), int(event.y))
        if path_info is None:
            # Empty space — get ready to marquee-select from here
            self._marquee = {"mode": "marquee", "ax": event.x, "ay": event.y,
                             "a_idx": None, "started": False}
            sel.unselect_all()
            return True
        tree_path, _col, _, _ = path_info
        idx = tree_path.get_indices()[0]
        if sel.path_is_selected(tree_path):
            # Click on already-selected row — might be a drag-out
            self._marquee = {"mode": "maybedrag", "ax": event.x, "ay": event.y,
                             "a_idx": idx, "started": False}
            return True  # eat click so GTK doesn't deselect others yet
        # Unselected row — fresh marquee, anchored at this row
        sel.unselect_all()
        sel.select_path(tree_path)
        self._marquee = {"mode": "marquee", "ax": event.x, "ay": event.y,
                         "a_idx": idx, "started": False}
        return True

    def _on_files_motion(self, view, event):
        if self._marquee is None:
            return False
        if not (event.state & Gdk.ModifierType.BUTTON1_MASK):
            self._marquee = None
            return False
        ax, ay = self._marquee["ax"], self._marquee["ay"]
        if not self._marquee["started"]:
            if abs(event.x - ax) < self.DRAG_THRESHOLD and \
               abs(event.y - ay) < self.DRAG_THRESHOLD:
                return False
            self._marquee["started"] = True

        if self._marquee["mode"] == "maybedrag":
            # Crossed threshold while pressing on a selected row — start
            # drag-out with the current selection's URIs.
            target_list = Gtk.TargetList.new(
                [Gtk.TargetEntry.new("text/uri-list", 0, 0)])
            Gtk.drag_begin_with_coordinates(
                view, target_list, Gdk.DragAction.COPY, 1, event,
                int(event.x), int(event.y))
            self._marquee = None
            return True

        # mode == "marquee": update range-select from anchor to row under cursor.
        # Only act when the row under the cursor actually changes (throttling)
        # and use select_range (single GTK call) instead of per-row select.
        n = len(self.files_store)
        if n == 0:
            return False
        path_info = view.get_path_at_pos(int(event.x), max(0, int(event.y)))
        if path_info is None:
            cur_idx = n - 1 if event.y > ay else 0
        else:
            cur_path, _, _, _ = path_info
            cur_idx = cur_path.get_indices()[0]
        # Skip work if the row hasn't changed since last update
        if self._marquee.get("last_idx") == cur_idx:
            return True
        self._marquee["last_idx"] = cur_idx
        anchor_idx = self._marquee["a_idx"]
        if anchor_idx is None:
            anchor_idx = cur_idx
            self._marquee["a_idx"] = anchor_idx
        lo, hi = (anchor_idx, cur_idx) if anchor_idx <= cur_idx else (cur_idx, anchor_idx)
        sel = view.get_selection()
        start = Gtk.TreePath.new_from_indices([lo])
        end = Gtk.TreePath.new_from_indices([hi])
        sel.unselect_all()
        sel.select_range(start, end)
        return True

    def _on_files_release(self, view, event):
        if event.button != 1:
            return False
        if self._marquee is not None:
            if self._marquee["mode"] == "maybedrag" and not self._marquee["started"]:
                # Plain click on a selected row, no drag — collapse to single-select
                path_info = view.get_path_at_pos(int(event.x), int(event.y))
                if path_info is not None:
                    tree_path, _, _, _ = path_info
                    sel = view.get_selection()
                    sel.unselect_all()
                    sel.select_path(tree_path)
            self._marquee = None
        return False

    def on_files_drag_data_get(self, _view, _ctx, selection_data, _info, _time):
        """When a drag starts from the file list, fill the data with the URIs
        of the currently-selected media files."""
        paths = self.selected_file_paths()
        if not paths:
            return
        selection_data.set_uris([
            Gio.File.new_for_path(str(p)).get_uri() for p in paths
        ])

    def on_queue_drag_data_received(self, view, ctx, x, y, data, _info, time):
        """A URI list was dropped onto the queue (from the file list or an
        external app). Insert each file at the drop position."""
        try:
            target_name = data.get_target().name()
        except Exception:
            target_name = ""
        # Internal row reorders use a different target and are handled by
        # set_reorderable's built-in logic; we only act on URI lists.
        if target_name != "text/uri-list":
            return

        paths: list[Path] = []
        for uri in (data.get_uris() or []):
            parsed = urlparse(uri)
            if parsed.scheme != "file":
                continue
            p = Path(unquote(parsed.path))
            if p.exists() and p.is_file() and p.suffix.lower() in MEDIA_EXTS:
                paths.append(p)
        if not paths:
            Gtk.drag_finish(ctx, False, False, time)
            return

        # Figure out where in the queue to insert
        drop_info = view.get_dest_row_at_pos(int(x), int(y))
        if drop_info is None:
            insert_at = len(self.queue_paths)
        else:
            tree_path, position = drop_info
            idx = tree_path.get_indices()[0]
            if position in (Gtk.TreeViewDropPosition.BEFORE,
                            Gtk.TreeViewDropPosition.INTO_OR_BEFORE):
                insert_at = idx
            else:
                insert_at = idx + 1

        was_empty = self.current_index == -1
        for i, p in enumerate(paths):
            pos = insert_at + i
            self.queue_paths.insert(pos, p)
            if not was_empty and self.current_index >= pos:
                self.current_index += 1
        self.refresh_queue_view()
        if was_empty:
            self.play_index(insert_at)
        Gtk.drag_finish(ctx, True, False, time)

    def on_queue_drag_end(self, _view, _ctx):
        """After the user drag-reorders rows, rebuild queue_paths from the
        store's new order and re-locate the currently-playing track."""
        currently_playing = (self.queue_paths[self.current_index]
                             if 0 <= self.current_index < len(self.queue_paths)
                             else None)
        new_paths: list[Path] = []
        new_index = -1
        for i, row in enumerate(self.queue_store):
            p = Path(row[2])
            new_paths.append(p)
            if currently_playing is not None and p == currently_playing:
                new_index = i
        self.queue_paths = new_paths
        self.current_index = new_index
        # Re-render so the ▶ marker lands on the right row again
        self.refresh_queue_view()

    def on_queue_key(self, _view, event):
        if event.keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.on_queue_remove(None)
            return True
        return False

    def on_queue_button_press(self, view, event):
        # Left-click on the ✕ column: delete that row.
        if event.button == 1:
            path_info = view.get_path_at_pos(int(event.x), int(event.y))
            if path_info is not None:
                tree_path, col, _x, _y = path_info
                if col is self.del_col:
                    self._remove_queue_at(tree_path.get_indices()[0])
                    return True  # eat the event so row-activated doesn't fire
            return False
        if event.button != 3:  # otherwise we only care about right-click
            return False
        # Select the row under the cursor before showing the menu
        path_info = view.get_path_at_pos(int(event.x), int(event.y))
        if path_info is not None:
            path, _col, _x, _y = path_info
            view.get_selection().select_path(path)
        has_selection = self._queue_selected_index() is not None
        menu = Gtk.Menu()
        for label, cb, needs_sel in [
            ("Play this", lambda _: self.play_index(self._queue_selected_index() or 0), True),
            (None, None, False),
            ("Move up", self.on_queue_up, True),
            ("Move down", self.on_queue_down, True),
            (None, None, False),
            ("Remove from queue", self.on_queue_remove, True),
            ("Clear entire queue", self.on_queue_clear, False),
        ]:
            if label is None:
                menu.append(Gtk.SeparatorMenuItem())
                continue
            item = Gtk.MenuItem(label=label)
            if needs_sel and not has_selection:
                item.set_sensitive(False)
            item.connect("activate", lambda _i, fn=cb: fn(None))
            menu.append(item)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def _queue_selected_index(self):
        sel = self.queue_view.get_selection()
        model, treeiter = sel.get_selected()
        if treeiter is None:
            return None
        return model.get_path(treeiter).get_indices()[0]

    def on_queue_up(self, _btn):
        i = self._queue_selected_index()
        if i is None or i <= 0:
            return
        self.queue_paths[i - 1], self.queue_paths[i] = self.queue_paths[i], self.queue_paths[i - 1]
        if self.current_index == i:
            self.current_index -= 1
        elif self.current_index == i - 1:
            self.current_index += 1
        self.refresh_queue_view()
        self.queue_view.get_selection().select_path(Gtk.TreePath.new_from_indices([i - 1]))

    def on_queue_down(self, _btn):
        i = self._queue_selected_index()
        if i is None or i >= len(self.queue_paths) - 1:
            return
        self.queue_paths[i + 1], self.queue_paths[i] = self.queue_paths[i], self.queue_paths[i + 1]
        if self.current_index == i:
            self.current_index += 1
        elif self.current_index == i + 1:
            self.current_index -= 1
        self.refresh_queue_view()
        self.queue_view.get_selection().select_path(Gtk.TreePath.new_from_indices([i + 1]))

    def on_queue_remove(self, _btn):
        i = self._queue_selected_index()
        if i is None:
            return
        self._remove_queue_at(i)

    def _remove_queue_at(self, i: int):
        if i < 0 or i >= len(self.queue_paths):
            return
        was_current = i == self.current_index
        del self.queue_paths[i]
        if was_current:
            self.player.set_state(Gst.State.NULL)
            if i < len(self.queue_paths):
                self.play_index(i)
            else:
                self.current_index = -1
                self.now_label.set_text("—")
        elif i < self.current_index:
            self.current_index -= 1
        self.refresh_queue_view()

    def on_queue_clear(self, _btn):
        self.player.set_state(Gst.State.NULL)
        self.queue_paths.clear()
        self.current_index = -1
        self.now_label.set_text("—")
        self.refresh_queue_view()

    def refresh_queue_view(self):
        # Detach the model while we rebuild — avoids hundreds of intermediate
        # redraws when the queue has lots of rows.
        self.queue_view.freeze_child_notify()
        self.queue_view.set_model(None)
        try:
            self.queue_store.clear()
            for idx, p in enumerate(self.queue_paths):
                marker = "▶" if idx == self.current_index else ""
                rel_display = p.stem
                try:
                    rel = p.relative_to(self.folder)
                    if rel.parent != Path("."):
                        rel_display = f"{rel.parent}  /  {p.stem}"
                except ValueError:
                    pass
                self.queue_store.append([marker, rel_display, str(p)])
        finally:
            self.queue_view.set_model(self.queue_store)
            self.queue_view.thaw_child_notify()

    # --- playback ---------------------------------------------------------
    def _set_play_icon(self, playing: bool):
        name = "media-playback-pause-symbolic" if playing else "media-playback-start-symbolic"
        self.play_btn.set_image(Gtk.Image.new_from_icon_name(name, Gtk.IconSize.LARGE_TOOLBAR))

    def _notify_mpris(self, *props):
        if getattr(self, "mpris", None) is not None:
            try:
                self.mpris.notify(*props)
            except Exception as e:
                sys.stderr.write(f"[musicnode] mpris notify failed: {e}\n")

    def _move_play_marker(self, old_idx: int, new_idx: int):
        """Update just the ▶ marker on two queue rows in-place, instead of
        rebuilding the whole queue ListStore. Massive flicker reduction
        for the most-common operation (track change)."""
        n = len(self.queue_store)
        if 0 <= old_idx < n:
            self.queue_store[old_idx][0] = ""
        if 0 <= new_idx < n:
            self.queue_store[new_idx][0] = "▶"

    def play_index(self, idx: int):
        if idx < 0 or idx >= len(self.queue_paths):
            return
        old_idx = self.current_index
        # READY instead of NULL between tracks — keeps the video sink
        # warm so we don't get a black-flash on track change.
        self.player.set_state(Gst.State.READY)
        path = self.queue_paths[idx]
        self.player.set_property("uri", Gio.File.new_for_path(str(path)).get_uri())
        self.player.set_state(Gst.State.PLAYING)
        self.current_index = idx
        new_text = f"♪ {path.stem}"
        if self.now_label.get_text() != new_text:
            self.now_label.set_text(new_text)
        new_title = f"{path.stem} — MusicNode"
        if self.get_title() != new_title:
            self.set_title(new_title)
        self._set_play_icon(True)
        # In-place marker swap rather than full queue rebuild
        self._move_play_marker(old_idx, idx)
        # Metadata length isn't known immediately — give it a beat, then
        # re-notify so the lock screen picks up the duration.
        self._notify_mpris("PlaybackStatus", "Metadata")
        GLib.timeout_add(500, lambda: (self._notify_mpris("Metadata"), False)[1])

    def on_play_pause(self, _btn):
        if self.current_index == -1:
            if self.queue_paths:
                self.play_index(0)
            return
        _, state, _ = self.player.get_state(0)
        if state == Gst.State.PLAYING:
            self.player.set_state(Gst.State.PAUSED)
            self._set_play_icon(False)
        else:
            self.player.set_state(Gst.State.PLAYING)
            self._set_play_icon(True)
        self._notify_mpris("PlaybackStatus")

    def on_stop(self, _btn):
        self.player.set_state(Gst.State.NULL)
        self._set_play_icon(False)
        self.pos_label.set_text("0:00")
        self.scale.set_value(0)
        self.set_title("MusicNode")
        self._notify_mpris("PlaybackStatus", "Metadata")

    def on_prev(self, _btn):
        if self.current_index > 0:
            self.play_index(self.current_index - 1)

    def on_next(self, _btn):
        if self.current_index + 1 < len(self.queue_paths):
            self.play_index(self.current_index + 1)
        else:
            self.on_stop(None)
            self.current_index = -1
            self.now_label.set_text("—")
            self.refresh_queue_view()

    def on_eos(self, _bus, _msg):
        self.on_next(None)

    def on_gst_error(self, _bus, msg):
        err, dbg = msg.parse_error()
        sys.stderr.write(f"[gst] {err}: {dbg}\n")
        self.on_next(None)

    def on_scale_release(self, _w, _ev):
        ok_d, dur = self.player.query_duration(Gst.Format.TIME)
        if ok_d and dur > 0:
            target = int(self.scale.get_value() * dur)
            self.player.seek_simple(
                Gst.Format.TIME,
                Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                target,
            )
        self.seeking = False
        return False

    def tick(self):
        if self.seeking or self.current_index == -1:
            return True
        ok_d, dur = self.player.query_duration(Gst.Format.TIME)
        ok_p, pos = self.player.query_position(Gst.Format.TIME)
        if ok_d and dur > 0:
            new_dur = fmt_time(dur)
            if self.dur_label.get_text() != new_dur:
                self.dur_label.set_text(new_dur)
            if ok_p:
                new_pos = fmt_time(pos)
                if self.pos_label.get_text() != new_pos:
                    self.pos_label.set_text(new_pos)
                # Only nudge the slider if the change is meaningful;
                # otherwise GTK does a redraw for nothing.
                new_val = pos / dur
                if abs(self.scale.get_value() - new_val) > 0.001:
                    self.scale.set_value(new_val)
        return True

    # --- state persistence ------------------------------------------------
    def load_state(self):
        # Migrate old config dir if present
        old = Path.home() / ".config" / "music-queue" / "state.json"
        candidates = [STATE_PATH, old]
        for c in candidates:
            try:
                data = json.loads(c.read_text())
                folder = data.get("folder")
                if folder and Path(folder).exists():
                    self.folder = Path(folder)
                self.queue_paths = [Path(p) for p in data.get("queue", []) if Path(p).exists()]
                sink = data.get("audio_sink")
                if isinstance(sink, str) and sink:
                    self.current_audio_sink = sink
                return
            except FileNotFoundError:
                continue
            except Exception as e:
                sys.stderr.write(f"[musicnode] could not load {c}: {e}\n")

    def save_state(self):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            STATE_PATH.write_text(json.dumps({
                "folder": str(self.folder),
                "queue": [str(p) for p in self.queue_paths],
                "audio_sink": self.current_audio_sink,
            }, indent=2))
        except Exception as e:
            sys.stderr.write(f"[musicnode] could not save state: {e}\n")

    def on_destroy(self, *_):
        self.player.set_state(Gst.State.NULL)
        self.save_state()


if _HAVE_DBUS:
    class MprisService(dbus.service.Object):
        """Expose the player on the system bus via MPRIS v2.

        The desktop environment (Cinnamon's sound applet and lock screen,
        GNOME Shell, KDE, etc.) reads this to show now-playing info and
        remote-control buttons.
        """
        BUS_NAME = "org.mpris.MediaPlayer2.MusicNode"
        OBJECT_PATH = "/org/mpris/MediaPlayer2"
        ROOT_IFACE = "org.mpris.MediaPlayer2"
        PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
        PROPS_IFACE = "org.freedesktop.DBus.Properties"

        def __init__(self, app: "MusicPlayer"):
            self.app = app
            self._track_counter = 0
            bus_name = dbus.service.BusName(self.BUS_NAME, dbus.SessionBus())
            super().__init__(bus_name, self.OBJECT_PATH)

        # --- helpers ----------------------------------------------------
        def _status(self) -> str:
            try:
                _, state, _ = self.app.player.get_state(0)
            except Exception:
                return "Stopped"
            if state == Gst.State.PLAYING:
                return "Playing"
            if state == Gst.State.PAUSED:
                return "Paused"
            return "Stopped"

        def _metadata(self) -> "dbus.Dictionary":
            meta: dict = {
                "mpris:trackid": dbus.ObjectPath(
                    "/org/mpris/MediaPlayer2/TrackList/NoTrack"),
            }
            if 0 <= self.app.current_index < len(self.app.queue_paths):
                p = self.app.queue_paths[self.app.current_index]
                self._track_counter += 1
                meta = {
                    "mpris:trackid": dbus.ObjectPath(
                        f"/org/mpris/MediaPlayer2/Track/{self._track_counter}"),
                    "xesam:title": p.stem,
                    "xesam:url": Gio.File.new_for_path(str(p)).get_uri(),
                    "xesam:artist": dbus.Array([p.parent.name or "MusicNode"],
                                               signature="s"),
                }
                try:
                    ok, dur = self.app.player.query_duration(Gst.Format.TIME)
                    if ok and dur > 0:
                        meta["mpris:length"] = dbus.Int64(dur // 1000)
                except Exception:
                    pass
            return dbus.Dictionary(meta, signature="sv")

        def _player_props(self) -> dict:
            try:
                vol = float(self.app.player.get_property("volume"))
            except Exception:
                vol = 1.0
            try:
                ok, pos = self.app.player.query_position(Gst.Format.TIME)
                position = (pos // 1000) if ok and pos >= 0 else 0
            except Exception:
                position = 0
            return {
                "PlaybackStatus": self._status(),
                "LoopStatus": "None",
                "Rate": 1.0,
                "Shuffle": False,
                "Metadata": self._metadata(),
                "Volume": vol,
                "Position": dbus.Int64(position),
                "MinimumRate": 1.0,
                "MaximumRate": 1.0,
                "CanGoNext": True,
                "CanGoPrevious": True,
                "CanPlay": True,
                "CanPause": True,
                "CanSeek": True,
                "CanControl": True,
            }

        def _root_props(self) -> dict:
            return {
                "CanQuit": True,
                "CanRaise": True,
                "HasTrackList": False,
                "Identity": "MusicNode",
                "DesktopEntry": "musicnode",
                "SupportedUriSchemes": dbus.Array(["file"], signature="s"),
                "SupportedMimeTypes": dbus.Array(
                    ["audio/mpeg", "audio/mp4", "audio/x-vorbis+ogg",
                     "video/mp4", "video/x-matroska", "video/webm"],
                    signature="s"),
            }

        def notify(self, *prop_names: str):
            """Emit PropertiesChanged for the named player properties."""
            props = self._player_props()
            changed = {k: props[k] for k in prop_names if k in props}
            if changed:
                self.PropertiesChanged(self.PLAYER_IFACE, changed, [])

        # --- Properties interface ---------------------------------------
        @dbus.service.method(PROPS_IFACE, in_signature="ss", out_signature="v")
        def Get(self, interface, prop):
            if interface == self.ROOT_IFACE:
                return self._root_props()[prop]
            if interface == self.PLAYER_IFACE:
                return self._player_props()[prop]
            raise dbus.exceptions.DBusException(
                f"No such interface: {interface}")

        @dbus.service.method(PROPS_IFACE, in_signature="s",
                             out_signature="a{sv}")
        def GetAll(self, interface):
            if interface == self.ROOT_IFACE:
                return self._root_props()
            if interface == self.PLAYER_IFACE:
                return self._player_props()
            return {}

        @dbus.service.method(PROPS_IFACE, in_signature="ssv")
        def Set(self, interface, prop, value):
            if interface == self.PLAYER_IFACE and prop == "Volume":
                v = max(0.0, min(1.0, float(value)))
                self.app.player.set_property("volume", v)
                try:
                    self.app.vol_scale.set_value(v)
                except Exception:
                    pass
                self.notify("Volume")

        @dbus.service.signal(PROPS_IFACE, signature="sa{sv}as")
        def PropertiesChanged(self, interface, changed_props, invalidated):
            pass

        # --- Root interface ---------------------------------------------
        @dbus.service.method(ROOT_IFACE)
        def Raise(self):
            self.app.present()

        @dbus.service.method(ROOT_IFACE)
        def Quit(self):
            self.app.close()

        # --- Player interface methods -----------------------------------
        @dbus.service.method(PLAYER_IFACE)
        def Next(self):
            self.app.on_next(None)

        @dbus.service.method(PLAYER_IFACE)
        def Previous(self):
            self.app.on_prev(None)

        @dbus.service.method(PLAYER_IFACE)
        def Pause(self):
            self.app.player.set_state(Gst.State.PAUSED)
            self.app._set_play_icon(False)
            self.notify("PlaybackStatus")

        @dbus.service.method(PLAYER_IFACE)
        def PlayPause(self):
            self.app.on_play_pause(None)

        @dbus.service.method(PLAYER_IFACE)
        def Play(self):
            if self.app.current_index == -1 and self.app.queue_paths:
                self.app.play_index(0)
            else:
                self.app.player.set_state(Gst.State.PLAYING)
                self.app._set_play_icon(True)
                self.notify("PlaybackStatus")

        @dbus.service.method(PLAYER_IFACE)
        def Stop(self):
            self.app.on_stop(None)
            self.notify("PlaybackStatus", "Metadata")

        @dbus.service.method(PLAYER_IFACE, in_signature="x")
        def Seek(self, offset_us):
            try:
                ok, pos = self.app.player.query_position(Gst.Format.TIME)
                if not ok:
                    return
                target = max(0, pos + offset_us * 1000)
                self.app.player.seek_simple(
                    Gst.Format.TIME,
                    Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                    target,
                )
                self.Seeked(target // 1000)
            except Exception:
                pass

        @dbus.service.method(PLAYER_IFACE, in_signature="ox")
        def SetPosition(self, _trackid, position_us):
            try:
                self.app.player.seek_simple(
                    Gst.Format.TIME,
                    Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                    position_us * 1000,
                )
                self.Seeked(position_us)
            except Exception:
                pass

        @dbus.service.signal(PLAYER_IFACE, signature="x")
        def Seeked(self, position_us):
            pass


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.customernode.MusicNode",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = MusicPlayer(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
